{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "FPGA Image Server",
            "type": "shell",
            "command": "node server.js ${workspaceFolder}/images",
            "options": {
                "cwd": "/opt/fpgaprog",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true,
            },
        },
        {
            "label": "Rebuild Tasks",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/rebuildTasks",
            "options": {
                "cwd": "${workspaceFolder}/.devcontainer",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true,
            },
        },
        {
            "label": "1.1 Simulate and_gate.sv",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/makehdl products/and_gate.rtl.json",
            "options": {
                "cwd": "${workspaceFolder}/and_gate",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true,
            },
            "problemMatcher": {
                "base": "$yosys",
                "owner": "and_gate: simulate",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/and_gate",
                ],
            },
        },
        {
            "label": "1.2 Edit and_gate.sv",
            "type": "shell",
            "command": "code ${workspaceFolder}/and_gate/and_gate.sv",
        },
        {
            "label": "1.3 and_gate testbench verification",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/makehdl products/and_gate_tb.vcd",
            "options": {
                "cwd": "${workspaceFolder}/and_gate",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true,
            },
            "problemMatcher": {
                "base": "$vvp",
                "owner": "and_gate_tb: testbench",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/and_gate",
                ],
            },
        },
        {
            "label": "1.4 and_gate iCE40 bitstream",
            "type": "shell",
            "command": "${workspaceFolder}/.devcontainer/makehdl products/and_gate.bin",
            "options": {
                "cwd": "${workspaceFolder}/and_gate",
            },
            "presentation": {
                "echo": true,
                "reveal": "silent",
                "revealProblems": "onProblem",
                "focus": false,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": true,
            },
            "problemMatcher": {
                "base": "$yosys",
                "owner": "and_gate: image",
                "fileLocation": [
                    "relative",
                    "${workspaceFolder}/and_gate",
                ],
            },
        },
    ],
}